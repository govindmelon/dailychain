{
  "name": "kept-mobile",
  "version": "2.2.0",
  "private": true,
  "description": "Android app for Kept (a Capacitor shell around the same interface as the desktop app)",
  "scripts": {
    "web": "node scripts/build-www.js && cap sync android",
    "web:only": "node scripts/build-www.js",
    "test": "node --test test/*.test.js",
    "apk": "npm run web && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  },
  "engines": { "node": ">=22" },
  "license": "UNLICENSED"
}
