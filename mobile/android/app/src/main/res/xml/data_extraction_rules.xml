<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same rule for cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sync.json"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sync.json"/>
    </device-transfer>
</data-extraction-rules>
